# ASTA environment. Copy to .env and fill what you need: `cp .env.example .env`
# .env is gitignored. YAML refers to these as ${VAR} and never stores them.

# Discord webhooks (one per market channel). Anyone with the URL can post.
DISCORD_WEBHOOK_FOREX=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_CRYPTO=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_STOCK=https://discord.com/api/webhooks/xxx/yyy

# Dashboard access. Generate with: openssl rand -hex 24
# Leave empty to let ASTA generate them once into data/share.json.
# editor = full control, viewer = read-only. Share the viewer link.
ASTA_EDITOR_TOKEN=
ASTA_VIEWER_TOKEN=

# MetaTrader 5 MCP (forex): local terminal for full history, public market data as fallback
MT5_TERMINAL_URL=http://127.0.0.1:22346/mcp
MT5_TERMINAL_TOKEN=your-local-mcp-token
MT5_MARKETDATA_URL=
MT5_MARKETDATA_TOKEN=

# OANDA (optional forex backend if providers.forex.type=oanda)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# Runtime
ASTA_CONFIG_DIR=config
ASTA_LOG_LEVEL=INFO
ASTA_LOG_FORMAT=text
# 1 = never post to Discord
ASTA_DRY_RUN=0

# Hosted deploys only -------------------------------------------------------
# Move data/ (history, scanner library, tokens, alert log) onto a mounted volume
# ASTA_DATA_DIR=/var/data
# Skip the first-run setup wizard when the deploy is configured by env + config
# ASTA_SETUP_COMPLETE=1

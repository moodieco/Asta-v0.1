# Discord webhooks (one per market channel)
DISCORD_WEBHOOK_FOREX=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_CRYPTO=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_STOCK=https://discord.com/api/webhooks/xxx/yyy

# OANDA (practice account is enough for V0.1; leave empty to skip forex)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# Runtime
ASTA_CONFIG_DIR=config
ASTA_LOG_LEVEL=INFO
ASTA_LOG_FORMAT=text
# 1 = never post to Discord
ASTA_DRY_RUN=0

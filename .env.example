# Discord webhooks (one per market channel)
DISCORD_WEBHOOK_FOREX=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_CRYPTO=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_STOCK=https://discord.com/api/webhooks/xxx/yyy

# MetaTrader 5 MCP (forex): local terminal for full history, public market data as fallback
MT5_TERMINAL_URL=http://127.0.0.1:22346/mcp
MT5_TERMINAL_TOKEN=your-local-mcp-token
MT5_MARKETDATA_URL=https://www.metatrader.com/mcp
MT5_MARKETDATA_TOKEN=your-marketdata-token

# OANDA (optional forex backend if providers.forex.type=oanda)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# Runtime
ASTA_CONFIG_DIR=config
ASTA_LOG_LEVEL=INFO
ASTA_LOG_FORMAT=text
# 1 = never post to Discord
ASTA_DRY_RUN=0

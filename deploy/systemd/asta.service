[Unit]
Description=ASTA signal scanner + dashboard
Documentation=file://@ASTA_ROOT@/docs/TAILSCALE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@ASTA_ROOT@
ExecStart=@ASTA_BIN@ serve --host 127.0.0.1 --port 4310 --no-browser
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

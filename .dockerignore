# Everything the image does not need. Keeping this tight makes the Render build
# fast and stops local runtime state (history, tokens) leaking into a layer.
# NOTE: the web build stage needs web/src + web/index.html — never exclude those.
.git
.gitignore
.github
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.eggs
*.egg-info
build
dist

node_modules
web/node_modules
web/dist

data
*.log
.env
.env.*
!.env.example
.DS_Store

docs
tests
scripts
launcher
